# Download on the host, then configure legacy build containers without network.
include("${CMAKE_CURRENT_LIST_DIR}/dependency_sources.cmake")
if(NOT DEFINED JOSIM_DEPENDENCY_DIR)
  message(FATAL_ERROR "Set JOSIM_DEPENDENCY_DIR to a task-owned build directory")
endif()
get_filename_component(JOSIM_DEPENDENCY_DIR "${JOSIM_DEPENDENCY_DIR}" ABSOLUTE)
file(TO_CMAKE_PATH "${JOSIM_DEPENDENCY_DIR}" JOSIM_DEPENDENCY_DIR)
file(MAKE_DIRECTORY "${JOSIM_DEPENDENCY_DIR}/archives")
set(initial_cache "# Generated dependency source locations.\n")

foreach(dependency IN LISTS JOSIM_DEPENDENCIES)
  set(hash "${JOSIM_${dependency}_SHA256}")
  set(archive "${JOSIM_DEPENDENCY_DIR}/archives/${dependency}-${hash}.tar.gz")
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" existing_hash)
    if(NOT existing_hash STREQUAL hash)
      message(FATAL_ERROR "Cached dependency archive checksum mismatch: ${archive}")
    endif()
  else()
    file(DOWNLOAD "${JOSIM_${dependency}_URL}" "${archive}"
      EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON STATUS download_status)
    list(GET download_status 0 download_code)
    if(NOT download_code EQUAL 0)
      message(FATAL_ERROR "Dependency download failed: ${download_status}")
    endif()
  endif()

  set(destination "${JOSIM_DEPENDENCY_DIR}/${dependency}-${hash}")
  if(NOT EXISTS "${destination}")
    set(extract_dir "${JOSIM_DEPENDENCY_DIR}/extract-${dependency}")
    if(EXISTS "${extract_dir}")
      message(FATAL_ERROR "Interrupted extraction exists; inspect it before retrying: ${extract_dir}")
    endif()
    file(MAKE_DIRECTORY "${extract_dir}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${archive}"
                    WORKING_DIRECTORY "${extract_dir}" RESULT_VARIABLE extract_result)
    if(NOT extract_result EQUAL 0)
      message(FATAL_ERROR "Dependency extraction failed: ${dependency}")
    endif()
    file(RENAME "${extract_dir}/${JOSIM_${dependency}_ROOT}" "${destination}")
    file(REMOVE_RECURSE "${extract_dir}")
    file(WRITE "${destination}/.josim-archive-sha256" "${hash}\n")
  else()
    if(NOT EXISTS "${destination}/.josim-archive-sha256")
      message(FATAL_ERROR "Existing source directory has no provenance marker: ${destination}")
    endif()
    file(READ "${destination}/.josim-archive-sha256" recorded_hash)
    string(STRIP "${recorded_hash}" recorded_hash)
    if(NOT recorded_hash STREQUAL hash)
      message(FATAL_ERROR "Existing source directory has a different archive identity: ${destination}")
    endif()
  endif()
  string(TOUPPER "${dependency}" uppercase_name)
  string(APPEND initial_cache
    "set(FETCHCONTENT_SOURCE_DIR_${uppercase_name} [=[${destination}]=] CACHE PATH \"Pinned dependency source\" FORCE)\n")
  message(STATUS "Prepared ${dependency}: SHA256=${hash}")
endforeach()
file(WRITE "${JOSIM_DEPENDENCY_DIR}/sources.cmake" "${initial_cache}")
